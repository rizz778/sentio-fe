# ============================================================
# Sentio — Frontend (Vite/React)
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# API Gateway & Backend Services
# All REST and WebSocket traffic goes through the gateway.
# ----------------------------------------------------------
VITE_GATEWAY_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# Node Backend (Storage Engine, used for health probes and direct sync)
# On Render production: https://sentio-node-backend.onrender.com
# Locally: http://localhost:5000
VITE_NODE_BACKEND_URL=http://localhost:5000

# Legacy / fallback base URL (some older files may read this)
# Keep in sync with VITE_GATEWAY_URL.
VITE_API_BASE_URL=http://localhost:4000

# ----------------------------------------------------------
# WebSocket — Gemini Live Audio
# This is the WebSocket endpoint exposed by the Gateway for
# real-time audio sessions (modalities=AUDIO).
# Format: ws://<gateway-host>:<port>/ws/live
# ----------------------------------------------------------
VITE_GEMINI_WS_AUDIO_URL=ws://localhost:4000/ws/live

# ----------------------------------------------------------
# Google OAuth 2.0
# Create a Web Application credential in Google Cloud Console.
# Add http://localhost:5173 to "Authorised JavaScript origins".
# ----------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
